# Copia este archivo a .env.local y rellena los valores.
# Los valores de Supabase los encuentras en tu proyecto de Supabase > Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Llave pública: acepta tanto la "anon key" clásica como la nueva "publishable key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica
# Llave secreta (service_role o secret key). NUNCA debe exponerse al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-secreta
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opcional, para envío futuro de WhatsApp Business API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
